# ==== Telegram ====
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Админы бота (могут управлять им в личке: /stats, /config, /set, /unban, ...).
# Ники через запятую (с @ или без). Ник можно сменить — для надёжности укажите ID.
ADMIN_USERNAMES=@your_nick
# ID админов через запятую (надёжнее ника; узнать у @userinfobot).
ADMIN_USER_IDS=

# (опц.) ID чата/канала для лога действий и алертов. Пусто — только stdout.
# Для супергрупп/каналов это число вида -100xxxxxxxxxx.
ADMIN_CHAT_ID=

# Разрешённые чаты (через запятую). Пусто = работать ВЕЗДЕ (не рекомендуется:
# кто угодно сможет добавить бота к себе и расходовать вашу квоту OpenRouter).
# Бот сам выходит из чатов, которых нет в списке.
ALLOWED_CHAT_IDS=

# ==== OpenRouter ====
# Ключ с https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Основная модель-классификатор (можно сменить на лету: /set model <id>).
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
# Резервные модели через запятую (пробуются по очереди при ошибке основной).
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free

# ==== Поведение модерации (дефолты; меняются на лету командой /set) ====
SPAM_CONFIDENCE_THRESHOLD=0.85
TRUST_AFTER_CLEAN_MSGS=3
TRUST_AFTER_HOURS=24
MAX_CHARS_TO_LLM=2000
MIN_CHARS_FOR_LLM=2
GROUP_TOPIC=

# ==== Прочее ====
LLM_TIMEOUT_SECONDS=8
# Сколько ошибок LLM подряд до алерта админу.
LLM_ERROR_ALERT_THRESHOLD=5
DB_PATH=/app/data/bot.db
LOG_LEVEL=INFO
HTTP_REFERER=https://github.com/antispam-bot
APP_TITLE=AntispamBot
