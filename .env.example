# ==== Telegram ====
# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Bot admins (can manage it in DM: /stats, /config, /set, /unban, ...).
# Usernames, comma-separated (with or without @). Usernames can change — prefer IDs.
ADMIN_USERNAMES=@your_nick
# Admin IDs, comma-separated (more reliable than usernames; ask @userinfobot).
ADMIN_USER_IDS=

# (optional) Chat/channel ID for the action log and alerts. Empty = stdout only.
# For supergroups/channels this looks like -100xxxxxxxxxx.
ADMIN_CHAT_ID=

# Allowed chats (comma-separated). Empty = work EVERYWHERE (not recommended:
# anyone could add the bot to their group and burn your LLM quota).
# The bot leaves chats that are not on this list.
ALLOWED_CHAT_IDS=

# (optional) Proxy for ALL Telegram API traffic (Bot API + long polling).
# Empty = direct connection. Useful where api.telegram.org is blocked.
# Examples: socks5h://127.0.0.1:1080 , socks5h://user:pass@host:1080 ,
# http://user:pass@host:8080 . SOCKS support ships by default (httpx[socks]).
TELEGRAM_PROXY=

# ==== Classifier backend ====
# One of: openai_compat | anthropic | ollama | heuristic
CLASSIFIER_BACKEND=openai_compat

# ==== LLM connection (provider-neutral; OPENROUTER_* still accepted) ====
# For OpenRouter: key from https://openrouter.ai/keys
LLM_API_KEY=sk-or-v1-...
# OpenRouter default. For OpenAI/Together/Groq/vLLM/LM Studio set the matching /v1 URL.
# For anthropic backend use https://api.anthropic.com ; for ollama http://localhost:11434
LLM_BASE_URL=https://openrouter.ai/api/v1
# Primary model (changeable at runtime: /set model <id>).
LLM_MODEL=google/gemini-2.0-flash-lite-001
# Fallback models, comma-separated (tried in order when the primary fails).
LLM_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free

# ==== Moderation defaults (seed values; changeable at runtime via /set) ====
BOT_LANGUAGE=en
SPAM_CONFIDENCE_THRESHOLD=0.85
TRUST_AFTER_CLEAN_MSGS=3
TRUST_AFTER_HOURS=24
MAX_CHARS_TO_LLM=2000
MIN_CHARS_FOR_LLM=2
GROUP_TOPIC=

# ==== Misc ====
LLM_TIMEOUT_SECONDS=8
LLM_ERROR_ALERT_THRESHOLD=5
DB_PATH=/app/data/bot.db
LOG_LEVEL=INFO
HTTP_REFERER=https://github.com/kiselas/next_antibot
APP_TITLE=AntispamBot
